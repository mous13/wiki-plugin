{
    "name": "citadel/wiki-plugin",
    "description": "Wiki plugin for forumify",
    "type": "forumify-plugin",
    "keywords": [
        "symfony-ux"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Oscar Ellis"
        }
    ],
    "require": {
        "php": ">=8.4",
        "forumify/forumify-platform": "^1.3",
        "league/commonmark": "^2.7",
        "sebastian/diff": "^6.0"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.0",
        "dg/bypass-finals": "^1.9",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "slevomat/coding-standard": "^8.15",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "zenstruck/foundry": "2.8.7",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Citadel\\Wiki\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PluginTests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "lock": false
    },
    "extra": {
        "forumify-plugin-class": "Citadel\\Wiki\\CitadelWikiPlugin"
    }
}
