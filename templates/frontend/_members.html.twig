{% if isCategory and subcategories is not empty %}
    <div class="box mt-4">
        <h4>{{ 'wiki.page.subcategories'|trans }}</h4>
        <ul class="mb-0">
            {% for category in subcategories %}
                <li><a href="{{ path('wiki_page', { slug: wiki.slug, page: category.slug }) }}">{{ category.label }}</a></li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
{% if isCategory and members is not empty %}
    <div class="box mt-4">
        <h4>{{ 'wiki.page.category_members'|trans }}</h4>
        <ul class="mb-0">
            {% for member in members %}
                <li><a href="{{ path('wiki_page', { slug: wiki.slug, page: member.slug }) }}">{{ member.title }}</a></li>
            {% endfor %}
        </ul>
    </div>
{% endif %}
